# Phase 0 / S0 local development example
# Backend containers use the internal Docker network endpoint below.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/urban_dev

# PostgreSQL port mapping:
# - Container/internal port: 5432
# - Host/local port: 5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=urban_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres