# Phase 1.5 local development example
# Local host processes use localhost:5433.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/urban_dev

# Docker backend containers use this internal Docker network endpoint.
# docker-compose.yml sets this value for the backend service:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/urban_dev

# Alembic commands are run from the project root:
# alembic upgrade head

# PostgreSQL port mapping:
# - Container/internal port: 5432
# - Host/local port: 5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=urban_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MOLEG / National Law Information Center integration preparation.
# Keep real keys only in local .env or deployment secrets. Never commit them.
MOLEG_API_ENABLED=false
MOLEG_API_BASE_URL=https://www.law.go.kr
MOLEG_API_KEY=
# MOLEG_OC is accepted as an alias for MOLEG_API_KEY when needed.
MOLEG_OC=
MOLEG_API_TIMEOUT_SECONDS=5
# Live tests are skipped unless this is true and API configuration is present.
MOLEG_LIVE_TEST_ENABLED=false

# React development server origins allowed by FastAPI CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional MOLEG live transport retry controls. Keep secrets only in local .env.
MOLEG_API_RETRY_COUNT=1
MOLEG_API_RETRY_BACKOFF_SECONDS=0.25

# Optional OpenAI-compatible generation. Keep real credentials only in local
# environment/deployment secrets. TEST_ONLY providers are never selected here.
GENERATION_PROVIDER=
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_API_KEY=
GENERATION_MODEL=
GENERATION_TIMEOUT_SECONDS=30
